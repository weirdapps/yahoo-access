.venv/
__pycache__/
*.pyc
.ruff_cache/
accounts.json
.yahoo-mail/

# Secrets. A bare `.env` line does not cover `.env.bak-*`, `.env.local` or
# `.env.production`, so a timestamped backup written next to a live `.env` is
# one `git add -A` away from a commit. Keep the rule in the repo rather than in
# a global ignore file, which is machine-local and protects neither a fresh
# clone nor CI nor a deployed copy.
.env
.env.*
# Credential-shaped files. A stray `cp ~/keys/whatever.pem .` is otherwise one
# `git add -A` away from a commit. A global ignore is not a substitute, because
# no clone and no CI runner ever reads one.
*.pem
*.key


# Coverage artefacts. `.coverage` is a file and `htmlcov/` a directory,
# so both forms are needed; a bare `htmlcov` would not match the directory.
.coverage
.coverage.*
htmlcov/
